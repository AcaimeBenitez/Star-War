{
  "name": "galaxia-sw",
  "version": "1.0.0",
  "description": "Guía accesible (WCAG 2.1 AA) de películas de Star Wars con React y Bootstrap",
  "scripts": {
    "start": "npx serve . -l 3000",
    "audit:axe": "npx @axe-core/cli http://localhost:3000 --tags wcag2a,wcag2aa,wcag21a,wcag21aa",
    "audit:lighthouse": "npx lighthouse http://localhost:3000 --only-categories=accessibility --view"
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.3",
    "htm": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "private": true
}
